# PostgreSQL
POSTGRES_USER=beauty
POSTGRES_PASSWORD=beauty_secret
POSTGRES_DB=master_of_beauty
DATABASE_URL=postgresql://beauty:beauty_secret@postgres:5432/master_of_beauty?schema=public

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# API
API_PORT=4000
SALON_TZ=Europe/Kyiv
NODE_ENV=production
# Comma-separated origins in production, e.g. https://salon.ua
CORS_ORIGIN=
# Set true to also set HttpOnly cookies on login/refresh
AUTH_COOKIE=false
# Allow mock online deposit without real LiqPay (also on in non-production)
DEPOSIT_MOCK=true
# Auto-refund deposit when appointment is CANCELLED (not NO_SHOW)
DEPOSIT_AUTO_REFUND_ON_CANCEL=true

# Seed admin
SEED_ADMIN_EMAIL=admin@masterofbeauty.ua
SEED_ADMIN_PASSWORD=Admin123!

# Web
NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://api:4000/api/v1

# Public URL (LiqPay callbacks / result_url)
PUBLIC_BASE_URL=http://localhost

# SMS (MOCK | TURBOSMS | ALPHASMS)
SMS_PROVIDER=MOCK
SMS_ENABLED=true
SMS_SENDER=BeautyCRM
TURBOSMS_TOKEN=
ALPHASMS_API_KEY=

# LiqPay
LIQPAY_ENABLED=false
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

# SMTP email (optional)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@masterofbeauty.ua
