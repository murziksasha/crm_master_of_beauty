generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  RECEPTION
  MASTER
  ACCOUNTANT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ADMIN
  ONLINE
  PHONE
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
  TRANSFER
  LIQPAY
}

enum SaleItemType {
  SERVICE
  PRODUCT
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  SALE
}

enum LoyaltyTxType {
  EARN
  REDEEM
  ADJUST
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
}

enum PackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  BOOKED
  CANCELLED
  EXPIRED
}

enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum OnlinePaymentStatus {
  PENDING
  SUCCESS
  FAILURE
  REVERSED
}

enum SmsProvider {
  MOCK
  TURBOSMS
  ALPHASMS
}

enum SaleStatus {
  PAID
  REFUNDED
}

enum PayrollPeriodStatus {
  OPEN
  CLOSED
  PAID
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS
  PAYMENT
  REFUND
  LOGIN
  LOGOUT
  OTHER
}

model Salon {
  id                 String      @id @default(cuid())
  name               String
  address            String?
  phone              String?
  email              String?
  logoUrl            String?
  currency           String      @default("UAH")
  timezone           String      @default("Europe/Kyiv")
  workingHours       Json
  slotStepMin        Int         @default(15)
  defaultBufferMin   Int         @default(0)
  autoConfirmOnline  Boolean     @default(true)
  loyaltyEarnPercent Float       @default(5)
  loyaltyRedeemRate  Float       @default(1)
  pointsPerUah       Float       @default(1)
  // Online deposit (no-show protection)
  depositEnabled     Boolean     @default(false)
  depositRequired    Boolean     @default(false)
  depositPercent     Float       @default(30)
  // Integrations
  smsProvider        SmsProvider @default(MOCK)
  smsSender          String?
  smsEnabled         Boolean     @default(true)
  liqpayPublicKey    String?
  liqpayPrivateKey   String?
  liqpaySandbox      Boolean     @default(true)
  liqpayEnabled      Boolean     @default(false)
  publicBaseUrl      String?     // e.g. https://salon.ua for LiqPay result_url
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  branches           Branch[]
}

model Branch {
  id            String          @id @default(cuid())
  salonId       String
  salon         Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  name          String
  slug          String          @unique
  address       String?
  phone         String?
  email         String?
  isActive      Boolean         @default(true)
  isDefault     Boolean         @default(false)
  workingHours  Json?
  sortOrder     Int             @default(0)
  staff         StaffProfile[]
  appointments  Appointment[]
  sales         Sale[]
  products      Product[]
  waitlist      WaitlistEntry[]
  series        RecurringSeries[]
  onlinePays    OnlinePayment[]
  cashShifts    CashShift[]
  rooms         Room[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([salonId])
  @@index([isActive])
}

model Room {
  id           String        @id @default(cuid())
  branchId     String?
  branch       Branch?       @relation(fields: [branchId], references: [id])
  name         String
  capacity     Int           @default(1)
  color        String        @default("#A78BFA")
  isActive     Boolean       @default(true)
  sortOrder    Int           @default(0)
  notes        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([branchId])
  @@index([isActive])
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  role           Role            @default(RECEPTION)
  isActive       Boolean         @default(true)
  staffProfile   StaffProfile?
  sales          Sale[]          @relation("CashierSales")
  refundedSales  Sale[]          @relation("RefundedSales")
  stockMoves     StockMovement[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  cashShifts     CashShift[]     @relation("ShiftCashier")
  closedShifts   CashShift[]     @relation("ShiftCloser")
  closedPayrolls PayrollPeriod[] @relation("PayrollCloser")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PayrollPeriod {
  id           String              @id @default(cuid())
  branchId     String?
  fromDate     DateTime
  toDate       DateTime
  status       PayrollPeriodStatus @default(CLOSED)
  totalAmount  Decimal             @db.Decimal(12, 2)
  note         String?
  closedAt     DateTime            @default(now())
  closedById   String?
  closedBy     User?               @relation("PayrollCloser", fields: [closedById], references: [id])
  lines        PayrollLine[]
  createdAt    DateTime            @default(now())

  @@index([fromDate, toDate])
  @@index([status])
  @@index([branchId])
}

model PayrollLine {
  id             String        @id @default(cuid())
  periodId       String
  period         PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  staffId        String
  staffName      String
  commissionPct  Float
  serviceRevenue Decimal       @db.Decimal(12, 2)
  productRevenue Decimal       @db.Decimal(12, 2)
  revenue        Decimal       @db.Decimal(12, 2)
  salesCount     Int
  commission     Decimal       @db.Decimal(12, 2)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([periodId])
  @@index([staffId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction @default(OTHER)
  entity     String
  entityId   String?
  summary    String
  meta       Json?
  ip         String?
  createdAt  DateTime    @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model StaffProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])
  displayName     String
  bio             String?
  color           String           @default("#C4A484")
  photoUrl        String?
  commissionPct   Float            @default(0)
  specializations String[]
  isBookable      Boolean          @default(true)
  sortOrder       Int              @default(0)
  schedules       WorkSchedule[]
  timeOffs        TimeOff[]
  services        StaffService[]
  appointments    Appointment[]
  waitlist        WaitlistEntry[]
  series          RecurringSeries[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([branchId])
}

model WorkSchedule {
  id             String       @id @default(cuid())
  staffId        String
  staff          StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startTime      String
  endTime        String
  breakStart     String?
  breakEnd       String?
  isDayOff       Boolean      @default(false)

  @@unique([staffId, dayOfWeek])
  @@index([staffId])
}

model TimeOff {
  id        String       @id @default(cuid())
  staffId   String
  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime     @default(now())

  @@index([staffId, startAt, endAt])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id                    String              @id @default(cuid())
  categoryId            String
  category              ServiceCategory     @relation(fields: [categoryId], references: [id])
  name                  String
  description           String?
  durationMin           Int
  price                 Decimal             @db.Decimal(12, 2)
  bufferMin             Int                 @default(0)
  isActive              Boolean             @default(true)
  requiresConsultation  Boolean             @default(false)
  sortOrder             Int                 @default(0)
  staffLinks            StaffService[]
  appointmentServices   AppointmentService[]
  packageTemplates      ServicePackageTemplate[]
  waitlist              WaitlistEntry[]
  materials             ServiceMaterial[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  deletedAt             DateTime?

  @@index([categoryId])
  @@index([isActive])
}

/** BOM / recipe: materials consumed when service is sold/completed */
model ServiceMaterial {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Decimal  @db.Decimal(12, 3)
  unitNote  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceId, productId])
  @@index([productId])
}

model StaffService {
  id            String       @id @default(cuid())
  staffId       String
  serviceId     String
  staff         StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service       Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priceOverride Decimal?     @db.Decimal(12, 2)

  @@unique([staffId, serviceId])
}

model Client {
  id           String            @id @default(cuid())
  firstName    String
  lastName     String?
  phone        String            @unique
  email        String?
  birthDate    DateTime?
  notes        String?
  allergies    String?
  preferences  String?
  source       String?
  tags         String[]
  isActive     Boolean           @default(true)
  notesList    ClientNote[]
  appointments Appointment[]
  sales        Sale[]
  loyalty      LoyaltyAccount?
  packages     ClientPackage[]
  giftCerts    GiftCertificate[] @relation("GiftOwner")
  waitlist     WaitlistEntry[]
  series       RecurringSeries[]
  onlinePays   OnlinePayment[]
  portalOtps   ClientPortalOtp[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  @@index([phone])
  @@index([lastName, firstName])
}

/** Short-lived OTP for public client cabinet */
model ClientPortalOtp {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@index([expiresAt])
}

model ClientNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@index([clientId])
}

model RecurringSeries {
  id            String             @id @default(cuid())
  branchId      String?
  branch        Branch?            @relation(fields: [branchId], references: [id])
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id])
  staffId       String
  staff         StaffProfile       @relation(fields: [staffId], references: [id])
  serviceIds    String[]
  frequency     RecurringFrequency @default(WEEKLY)
  interval      Int                @default(1)
  startAt       DateTime
  endDate       DateTime?
  occurrences   Int                @default(8)
  timeOfDay     String
  notes         String?
  isActive      Boolean            @default(true)
  appointments  Appointment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([clientId])
  @@index([staffId])
  @@index([branchId])
}

model Appointment {
  id                 String               @id @default(cuid())
  branchId           String?
  branch             Branch?              @relation(fields: [branchId], references: [id])
  clientId           String
  client             Client               @relation(fields: [clientId], references: [id])
  staffId            String
  staff              StaffProfile         @relation(fields: [staffId], references: [id])
  roomId             String?
  room               Room?                @relation(fields: [roomId], references: [id])
  seriesId           String?
  series             RecurringSeries?     @relation(fields: [seriesId], references: [id])
  startAt            DateTime
  endAt              DateTime
  status             AppointmentStatus    @default(CONFIRMED)
  source             AppointmentSource    @default(ADMIN)
  notes              String?
  depositAmount      Decimal?             @db.Decimal(12, 2)
  depositPaidAt      DateTime?
  reminder24hSentAt  DateTime?
  reminder2hSentAt   DateTime?
  checkedInAt        DateTime?
  services           AppointmentService[]
  sale               Sale?
  onlinePay          OnlinePayment?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([staffId, startAt, endAt])
  @@index([clientId])
  @@index([startAt])
  @@index([status])
  @@index([branchId])
  @@index([seriesId])
  @@index([roomId, startAt, endAt])
  @@index([reminder24hSentAt, startAt])
  @@index([reminder2hSentAt, startAt])
}

model AppointmentService {
  id               String      @id @default(cuid())
  appointmentId    String
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service     @relation(fields: [serviceId], references: [id])
  nameSnapshot     String
  priceSnapshot    Decimal     @db.Decimal(12, 2)
  durationSnapshot Int
  sortOrder        Int         @default(0)

  @@index([appointmentId])
}

model WaitlistEntry {
  id               String         @id @default(cuid())
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id])
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  serviceId        String?
  service          Service?       @relation(fields: [serviceId], references: [id])
  staffId          String?
  staff            StaffProfile?  @relation(fields: [staffId], references: [id])
  preferredDate    DateTime?
  preferredTimeFrom String?
  preferredTimeTo   String?
  notes            String?
  status           WaitlistStatus @default(WAITING)
  notifiedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
  @@index([branchId])
  @@index([clientId])
  @@index([preferredDate])
}

model CashShift {
  id              String          @id @default(cuid())
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id])
  cashierId       String
  cashier         User            @relation("ShiftCashier", fields: [cashierId], references: [id])
  status          CashShiftStatus @default(OPEN)
  openingFloat    Decimal         @default(0) @db.Decimal(12, 2)
  closingCash     Decimal?        @db.Decimal(12, 2)
  expectedCash    Decimal?        @db.Decimal(12, 2)
  difference      Decimal?        @db.Decimal(12, 2)
  notes           String?
  openedAt        DateTime        @default(now())
  closedAt        DateTime?
  closedById      String?
  closedBy        User?           @relation("ShiftCloser", fields: [closedById], references: [id])
  sales           Sale[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([branchId, status])
  @@index([cashierId])
  @@index([openedAt])
}

model Sale {
  id               String        @id @default(cuid())
  number           String        @unique
  branchId         String?
  branch           Branch?       @relation(fields: [branchId], references: [id])
  appointmentId    String?       @unique
  appointment      Appointment?  @relation(fields: [appointmentId], references: [id])
  clientId         String?
  client           Client?       @relation(fields: [clientId], references: [id])
  cashierId        String
  cashier          User          @relation("CashierSales", fields: [cashierId], references: [id])
  cashShiftId      String?
  cashShift        CashShift?    @relation(fields: [cashShiftId], references: [id])
  subtotal         Decimal       @db.Decimal(12, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(12, 2)
  loyaltyRedeem    Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  method           PaymentMethod @default(CASH)
  cashAmount       Decimal?      @db.Decimal(12, 2)
  cardAmount       Decimal?      @db.Decimal(12, 2)
  notes            String?
  status           SaleStatus    @default(PAID)
  refundedAt       DateTime?
  refundReason     String?
  refundedById     String?
  refundedBy       User?         @relation("RefundedSales", fields: [refundedById], references: [id])
  paidAt           DateTime      @default(now())
  items            SaleItem[]
  loyaltyTx        LoyaltyTransaction[]
  onlinePay        OnlinePayment?
  createdAt        DateTime      @default(now())

  @@index([paidAt])
  @@index([clientId])
  @@index([cashierId])
  @@index([branchId])
  @@index([status])
  @@index([cashShiftId])
}

model SaleItem {
  id        String       @id @default(cuid())
  saleId    String
  sale      Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  type      SaleItemType
  refId     String?
  name      String
  qty       Decimal      @default(1) @db.Decimal(12, 3)
  unitPrice Decimal      @db.Decimal(12, 2)
  total     Decimal      @db.Decimal(12, 2)

  @@index([saleId])
}

model OnlinePayment {
  id              String              @id @default(cuid())
  branchId        String?
  branch          Branch?             @relation(fields: [branchId], references: [id])
  clientId        String?
  client          Client?             @relation(fields: [clientId], references: [id])
  appointmentId   String?             @unique
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id])
  saleId          String?             @unique
  sale            Sale?               @relation(fields: [saleId], references: [id])
  orderId         String              @unique
  amount          Decimal             @db.Decimal(12, 2)
  currency        String              @default("UAH")
  description     String
  status          OnlinePaymentStatus @default(PENDING)
  provider        String              @default("liqpay")
  liqpayPaymentId String?
  rawCallback     Json?
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([orderId])
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String          @id @default(cuid())
  branchId    String?
  branch      Branch?         @relation(fields: [branchId], references: [id])
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  name        String
  sku         String?         @unique
  brand       String?
  unit        String          @default("шт")
  stockQty    Decimal         @default(0) @db.Decimal(12, 3)
  minStock    Decimal         @default(0) @db.Decimal(12, 3)
  costPrice   Decimal         @default(0) @db.Decimal(12, 2)
  salePrice   Decimal         @db.Decimal(12, 2)
  isActive    Boolean         @default(true)
  movements   StockMovement[]
  materials   ServiceMaterial[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  @@index([name])
  @@index([isActive])
  @@index([branchId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  product   Product           @relation(fields: [productId], references: [id])
  type      StockMovementType
  qty       Decimal           @db.Decimal(12, 3)
  reason    String?
  userId    String?
  user      User?             @relation(fields: [userId], references: [id])
  createdAt DateTime          @default(now())

  @@index([productId])
  @@index([createdAt])
}

model LoyaltyAccount {
  id            String               @id @default(cuid())
  clientId      String               @unique
  client        Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pointsBalance Decimal              @default(0) @db.Decimal(12, 2)
  tier          LoyaltyTier          @default(BRONZE)
  lifetimeSpend Decimal              @default(0) @db.Decimal(12, 2)
  transactions  LoyaltyTransaction[]
  updatedAt     DateTime             @updatedAt
  createdAt     DateTime             @default(now())
}

model LoyaltyTransaction {
  id        String        @id @default(cuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      LoyaltyTxType
  points    Decimal       @db.Decimal(12, 2)
  saleId    String?
  sale      Sale?         @relation(fields: [saleId], references: [id])
  note      String?
  createdAt DateTime      @default(now())

  @@index([accountId])
}

model ServicePackageTemplate {
  id            String          @id @default(cuid())
  name          String
  serviceId     String?
  service       Service?        @relation(fields: [serviceId], references: [id])
  sessionsTotal Int
  price         Decimal         @db.Decimal(12, 2)
  validityDays  Int             @default(90)
  isActive      Boolean         @default(true)
  packages      ClientPackage[]
  createdAt     DateTime        @default(now())
}

model ClientPackage {
  id            String          @id @default(cuid())
  clientId      String
  client        Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId    String?
  template      ServicePackageTemplate? @relation(fields: [templateId], references: [id])
  name          String
  sessionsTotal Int
  sessionsLeft  Int
  pricePaid     Decimal         @db.Decimal(12, 2)
  status        PackageStatus   @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime        @default(now())

  @@index([clientId])
}

model GiftCertificate {
  id        String    @id @default(cuid())
  code      String    @unique
  balance   Decimal   @db.Decimal(12, 2)
  initial   Decimal   @db.Decimal(12, 2)
  ownerId   String?
  owner     Client?   @relation("GiftOwner", fields: [ownerId], references: [id])
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model SmsLog {
  id        String   @id @default(cuid())
  to        String
  body      String
  provider  String
  status    String
  response  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([to])
}
